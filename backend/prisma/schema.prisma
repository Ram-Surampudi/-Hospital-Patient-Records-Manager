generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id        String    @id @default(cuid())
  name      String
  email     String    @unique
  password  String
  role      String    @default("patient")
  isActive  Boolean   @default(true)
  createdBy String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model DoctorProfile {
  id               String   @id @default(cuid())
  specialization   String
  qualification    String
  experienceYears  Int
  licenseNumber    String
  department       String
  consultationFee  Float?
  userId           String   @unique
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model PatientProfile {
  id                String   @id @default(cuid())
  dateOfBirth       DateTime?
  bloodGroup        String?
  allergies         String?
  chronicConditions String?
  emergencyContact  String?
  emergencyPhone    String?
  userId            String   @unique
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model Hospital {
  id        String   @id @default(cuid())
  name      String
  type      String   @default("big")
  address   String
  phone     String
  email     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model HospitalAdmin {
  id         String   @id @default(cuid())
  hospitalId String
  adminId    String
  createdAt  DateTime @default(now())
  
  @@unique([hospitalId, adminId])
}

model HospitalDoctor {
  id         String   @id @default(cuid())
  hospitalId String
  doctorId   String
  createdAt  DateTime @default(now())
  
  @@unique([hospitalId, doctorId])
}

model Patient {
  id          String   @id @default(cuid())
  patientId   String   @unique
  name        String
  age         Int
  gender      String
  bloodGroup  String
  phone       String
  address     String?
  emergencyContact String?
  diagnosis   String?
  allergies   String?
  chronicConditions String?
  ward        String
  roomNumber  String?
  bedNumber   String?
  status      String   @default("admitted")
  admittedAt  DateTime @default(now())
  dischargedAt DateTime?
  hospitalId  String?
  userId      String?  @unique
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model AssignedPatient {
  id         String   @id @default(cuid())
  patientId  String
  doctorId   String
  assignedBy String
  assignedAt DateTime @default(now())
  isPrimary  Boolean  @default(false)
  notes      String?
  
  @@unique([patientId, doctorId])
}

model Message {
  id          String   @id @default(cuid())
  content     String   @db.Text
  type        String   @default("text")
  senderId    String
  receiverId  String
  patientId   String?
  isRead      Boolean  @default(false)
  readAt      DateTime?
  isEmergency Boolean  @default(false)
  attachments String?
  createdAt   DateTime @default(now())
}

model MedicalRecord {
  id          String   @id @default(cuid())
  patientId   String
  recordType  String
  title       String
  description String?  @db.Text
  fileUrl     String?
  createdBy   String
  createdAt   DateTime @default(now())
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  message   String   @db.Text
  type      String
  isRead    Boolean  @default(false)
  relatedId String?
  createdAt DateTime @default(now())
}